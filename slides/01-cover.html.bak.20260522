<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>롯데케미칼 · SAP S/4HANA 통합 ERP 고도화 사례</title>

  <!-- Fonts -->
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
  <link
    rel="stylesheet"
    as="style"
    crossorigin
    href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.min.css"
  />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  />

  <link rel="stylesheet" href="../shared/style.css" />
</head>
<body>

<!-- =================================================== -->
<!-- STAGE (16:9 fixed, scaled to viewport via JS)        -->
<!-- =================================================== -->
<div class="stage" id="stage">
  <div class="deck" id="deck">

    <!-- =============================================== -->
    <!-- SLIDE 01 · COVER  (페이지 톤: A · 임팩트형)      -->
    <!-- =============================================== -->
    <section class="slide slide-cover tone-a active" data-slide="1">

      <!-- ----- Background layer: molecule pattern (절제된 양만) ----- -->
      <svg
        class="bg-molecule"
        viewBox="0 0 1920 1080"
        preserveAspectRatio="xMidYMid slice"
        aria-hidden="true"
      >
        <defs>
          <g id="hex-node">
            <polygon
              points="0,-26 22.5,-13 22.5,13 0,26 -22.5,13 -22.5,-13"
              fill="none"
              stroke="currentColor"
              stroke-width="1"
            />
            <circle cx="0"      cy="-26" r="1.8" fill="currentColor" />
            <circle cx="22.5"   cy="-13" r="1.8" fill="currentColor" />
            <circle cx="22.5"   cy="13"  r="1.8" fill="currentColor" />
            <circle cx="0"      cy="26"  r="1.8" fill="currentColor" />
            <circle cx="-22.5"  cy="13"  r="1.8" fill="currentColor" />
            <circle cx="-22.5"  cy="-13" r="1.8" fill="currentColor" />
          </g>
        </defs>

        <!-- 좌측 상단 — 로고와 거리 두고 배치 (제목 영역 위쪽) -->
        <g class="molecule-cluster molecule-cluster--left">
          <use href="#hex-node" x="280" y="138" />
          <use href="#hex-node" x="370" y="138" />
          <use href="#hex-node" x="325" y="216" />
          <line x1="302" y1="151" x2="348" y2="151" stroke="currentColor" stroke-width="1" />
          <line x1="348" y1="190" x2="370" y2="151" stroke="currentColor" stroke-width="1" />
          <line x1="303" y1="190" x2="280" y2="151" stroke="currentColor" stroke-width="1" />
        </g>

        <!-- 우측 다이어그램 권역 — 화학 결합형 통합 구조 암시 -->
        <g class="molecule-cluster molecule-cluster--right">
          <use href="#hex-node" x="1540" y="252" />
          <use href="#hex-node" x="1630" y="252" />
          <use href="#hex-node" x="1585" y="330" />
          <use href="#hex-node" x="1720" y="252" />
          <line x1="1562" y1="265" x2="1608" y2="265" stroke="currentColor" stroke-width="1" />
          <line x1="1652" y1="265" x2="1698" y2="265" stroke="currentColor" stroke-width="1" />
          <line x1="1608" y1="304" x2="1630" y2="265" stroke="currentColor" stroke-width="1" />
          <line x1="1563" y1="304" x2="1540" y2="265" stroke="currentColor" stroke-width="1" />
        </g>

        <!-- 우상단 흩뿌림 한 점 -->
        <use class="molecule-cluster" href="#hex-node" x="1820" y="148" />
      </svg>

      <!-- =========== HEADER · slim 1-line =========== -->
      <header class="slide-head">
        <div class="brand">
          <img
            class="brand-logo"
            src="../shared/lotte-chemical-logo.jpeg"
            alt="롯데케미칼 로고"
          />
        </div>

        <div class="head-meta">
          <span class="hm-item">광운대학교 경영대학</span>
          <span class="hm-dot"></span>
          <span class="hm-item">ERP개론</span>
          <span class="hm-dot"></span>
          <span class="hm-item">기업 통합 ERP 사례 분석</span>
        </div>

        <div class="head-page">
          <span class="hp-num">01</span>
          <span class="hp-sep">/</span>
          <span class="hp-total">28</span>
        </div>
      </header>

      <!-- =========== MAIN · 좌(타이틀+메시지) / 우(다이어그램) =========== -->
      <main class="cover-main">

        <!-- ============ LEFT : Title / Subtitle / Quote ============ -->
        <div class="cover-left">

          <div class="eyebrow reveal" style="--rev-delay:0.1s">
            <span class="eb-bar"></span>
            <span class="eb-num">사례 01</span>
            <span class="eb-text">석유화학 산업의 글로벌 ERP 통합</span>
          </div>

          <h1 class="cover-title">
            <span class="t-line reveal" style="--rev-delay:0.25s">롯데케미칼은 왜</span>
            <span class="t-line reveal" style="--rev-delay:0.40s">
              <em class="t-em">SAP S/4HANA</em>로
            </span>
            <span class="t-line reveal" style="--rev-delay:0.55s">전환했는가?</span>
          </h1>

          <p class="cover-sub reveal" style="--rev-delay:0.80s">
            M&amp;A 이후 <strong>3사 통합</strong>과 <strong>글로벌 운영</strong>을 위한
            ERP 고도화 사례
          </p>

          <blockquote class="cover-message reveal" style="--rev-delay:1.00s">
            <p class="msg-body">
              이 사례는 단순한 ERP 도입을 넘어,
              <br />
              <span class="msg-hl">‘3사 통합 경영 기반’</span>을 구축한 프로젝트다.
            </p>
          </blockquote>
        </div>

        <!-- ============ RIGHT : Integration Diagram + slim KPI line ============ -->
        <aside class="cover-right">

          <div class="diagram-stage">
            <svg
              class="integration-svg"
              viewBox="0 0 660 660"
              preserveAspectRatio="xMidYMid meet"
              aria-label="3사 통합 ERP 구조도"
            >
              <defs>
                <linearGradient id="pipe-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                  <stop offset="0%"   stop-color="#C7C2B5" />
                  <stop offset="50%"  stop-color="#EFEBE0" />
                  <stop offset="100%" stop-color="#C7C2B5" />
                </linearGradient>
                <linearGradient id="pipe-grad-v" x1="0%" y1="0%" x2="0%" y2="100%">
                  <stop offset="0%"   stop-color="#C7C2B5" />
                  <stop offset="50%"  stop-color="#EFEBE0" />
                  <stop offset="100%" stop-color="#C7C2B5" />
                </linearGradient>
              </defs>

              <!-- 동심 궤도 (분자 궤도 + 시스템 권역 동시 암시) -->
              <g class="orbit-lines">
                <circle cx="330" cy="330" r="170" fill="none"
                        stroke="var(--svg-line-faint)" stroke-width="1"
                        stroke-dasharray="2 5" />
                <circle cx="330" cy="330" r="220" fill="none"
                        stroke="var(--svg-line-faint)" stroke-width="1"
                        stroke-dasharray="2 8" />
                <circle cx="330" cy="330" r="270" fill="none"
                        stroke="var(--svg-line-faint)" stroke-width="1"
                        stroke-dasharray="2 10" />
              </g>

              <!-- ===== Pipes (각 자회사 → 중앙 코어) ===== -->
              <!-- 상단 파이프 -->
              <g class="pipe pipe--top">
                <line x1="330" y1="170" x2="330" y2="270"
                      stroke="url(#pipe-grad-v)" stroke-width="14" />
                <line x1="330" y1="170" x2="330" y2="270"
                      stroke="var(--color-ink-mute)" stroke-width="1"
                      stroke-dasharray="4 6" opacity="0.6" />
                <rect x="318" y="178" width="24" height="5"
                      fill="var(--color-line)" stroke="var(--color-ink-faint)" stroke-width="0.5" />
                <rect x="318" y="257" width="24" height="5"
                      fill="var(--color-line)" stroke="var(--color-ink-faint)" stroke-width="0.5" />
                <circle class="flow-dot flow-dot--top" cx="330" cy="170" r="4" fill="var(--color-red)" />
              </g>

              <!-- 좌하단 파이프 -->
              <g class="pipe pipe--bl">
                <line x1="190" y1="476" x2="290" y2="390"
                      stroke="url(#pipe-grad)" stroke-width="14" />
                <line x1="190" y1="476" x2="290" y2="390"
                      stroke="var(--color-ink-mute)" stroke-width="1"
                      stroke-dasharray="4 6" opacity="0.6" />
                <g transform="translate(196,471) rotate(-40)">
                  <rect x="-2.5" y="-12" width="5" height="24"
                        fill="var(--color-line)" stroke="var(--color-ink-faint)" stroke-width="0.5" />
                </g>
                <g transform="translate(284,395) rotate(-40)">
                  <rect x="-2.5" y="-12" width="5" height="24"
                        fill="var(--color-line)" stroke="var(--color-ink-faint)" stroke-width="0.5" />
                </g>
                <circle class="flow-dot flow-dot--bl" cx="190" cy="476" r="4" fill="var(--color-red)" />
              </g>

              <!-- 우하단 파이프 -->
              <g class="pipe pipe--br">
                <line x1="470" y1="476" x2="370" y2="390"
                      stroke="url(#pipe-grad)" stroke-width="14" />
                <line x1="470" y1="476" x2="370" y2="390"
                      stroke="var(--color-ink-mute)" stroke-width="1"
                      stroke-dasharray="4 6" opacity="0.6" />
                <g transform="translate(464,471) rotate(40)">
                  <rect x="-2.5" y="-12" width="5" height="24"
                        fill="var(--color-line)" stroke="var(--color-ink-faint)" stroke-width="0.5" />
                </g>
                <g transform="translate(376,395) rotate(40)">
                  <rect x="-2.5" y="-12" width="5" height="24"
                        fill="var(--color-line)" stroke="var(--color-ink-faint)" stroke-width="0.5" />
                </g>
                <circle class="flow-dot flow-dot--br" cx="470" cy="476" r="4" fill="var(--color-red)" />
              </g>

              <!-- ===== CORE : SAP S/4HANA 통합 ERP 플랫폼 ===== -->
              <g class="node-core">
                <rect x="210" y="270" width="240" height="120" rx="4"
                      fill="var(--color-paper)"
                      stroke="var(--color-red)" stroke-width="3" />
                <text x="330" y="318"
                      text-anchor="middle"
                      font-family="JetBrains Mono"
                      font-size="23"
                      font-weight="600"
                      fill="var(--color-ink-strong)"
                      letter-spacing="0.02em"
                >SAP S/4HANA</text>
                <text x="330" y="350"
                      text-anchor="middle"
                      font-family="Pretendard"
                      font-size="15"
                      font-weight="600"
                      fill="var(--color-red)"
                >통합 ERP 플랫폼</text>

                <!-- 좌우 코너 크로스헤어 -->
                <g stroke="var(--color-red)" stroke-width="1.8" fill="none">
                  <path d="M 210,270 L 210,260 M 210,270 L 220,270" />
                  <path d="M 450,270 L 450,260 M 450,270 L 440,270" />
                  <path d="M 210,390 L 210,400 M 210,390 L 220,390" />
                  <path d="M 450,390 L 450,400 M 450,390 L 440,390" />
                </g>
              </g>

              <!-- ===== 자회사 노드 ===== -->
              <!-- 상단: 롯데케미칼 -->
              <g class="node node--top">
                <rect x="225" y="60" width="210" height="110" rx="4"
                      fill="var(--color-paper)"
                      stroke="var(--color-ink)" stroke-width="2" />
                <rect x="225" y="60" width="6" height="6" fill="var(--color-red)" />
                <text x="240" y="92"
                      font-family="Pretendard" font-size="13" font-weight="600"
                      fill="var(--color-red)" letter-spacing="0.02em"
                >기준 법인</text>
                <text x="240" y="124"
                      font-family="Pretendard" font-size="26" font-weight="700"
                      fill="var(--color-ink-strong)" letter-spacing="-0.01em"
                >롯데케미칼</text>
                <text x="240" y="150"
                      font-family="Pretendard" font-size="13" font-weight="500"
                      fill="var(--color-ink-soft)"
                >기존 SAP 운영 자산</text>
              </g>

              <!-- 좌하단: 롯데정밀화학 -->
              <g class="node node--bl">
                <rect x="30" y="478" width="200" height="100" rx="4"
                      fill="var(--color-paper)"
                      stroke="var(--color-ink)" stroke-width="2" />
                <rect x="30" y="478" width="6" height="6" fill="var(--color-red)" />
                <text x="45" y="510"
                      font-family="Pretendard" font-size="13" font-weight="500"
                      fill="var(--color-ink-mute)" letter-spacing="0.02em"
                >통합 대상</text>
                <text x="45" y="540"
                      font-family="Pretendard" font-size="24" font-weight="700"
                      fill="var(--color-ink-strong)" letter-spacing="-0.01em"
                >롯데정밀화학</text>
                <text x="45" y="563"
                      font-family="Pretendard" font-size="13" font-weight="500"
                      fill="var(--color-ink-soft)"
                >정밀화학 사업</text>
              </g>

              <!-- 우하단: 롯데첨단소재 -->
              <g class="node node--br">
                <rect x="430" y="478" width="200" height="100" rx="4"
                      fill="var(--color-paper)"
                      stroke="var(--color-ink)" stroke-width="2" />
                <rect x="430" y="478" width="6" height="6" fill="var(--color-red)" />
                <text x="445" y="510"
                      font-family="Pretendard" font-size="13" font-weight="500"
                      fill="var(--color-ink-mute)" letter-spacing="0.02em"
                >통합 대상</text>
                <text x="445" y="540"
                      font-family="Pretendard" font-size="24" font-weight="700"
                      fill="var(--color-ink-strong)" letter-spacing="-0.01em"
                >롯데첨단소재</text>
                <text x="445" y="563"
                      font-family="Pretendard" font-size="13" font-weight="500"
                      fill="var(--color-ink-soft)"
                >고기능 소재 사업</text>
              </g>

              <!-- 코어 펄스 -->
              <circle class="pulse-ring pulse-ring--1"
                      cx="330" cy="330" r="80" fill="none"
                      stroke="var(--color-red)" stroke-width="1.5" />
              <circle class="pulse-ring pulse-ring--2"
                      cx="330" cy="330" r="80" fill="none"
                      stroke="var(--color-red)" stroke-width="1.5" />
            </svg>
          </div>

          <!-- ===== 다이어그램 아래 inline KPI · 카드 아닌 텍스트 행 ===== -->
          <div class="key-line reveal" style="--rev-delay:1.40s">
            <div class="kl-item">
              <span class="kl-num"><span class="count" data-target="7">0</span><span class="kl-unit">개월</span></span>
              <span class="kl-label">압축 구축</span>
            </div>
            <span class="kl-divider"></span>
            <div class="kl-item">
              <span class="kl-num"><span class="count" data-target="3">0</span><span class="kl-unit">사</span></span>
              <span class="kl-label">통합 대상</span>
            </div>
            <span class="kl-divider"></span>
            <div class="kl-item">
              <span class="kl-num"><span class="count" data-target="10">0</span><span class="kl-unit">개</span></span>
              <span class="kl-label">핵심 업무 모듈</span>
            </div>
            <span class="kl-divider"></span>
            <div class="kl-item kl-item--emph">
              <span class="kl-num"><span class="count" data-target="110">0</span><span class="kl-unit">개국</span></span>
              <span class="kl-label">수출 운영 범위</span>
            </div>
          </div>

        </aside>
      </main>

      <!-- =========== FOOTER · 한 줄 메타 =========== -->
      <footer class="slide-foot">
        <span class="sf-left">2017.04 — 2017.11 · 총 7개월</span>
        <span class="sf-mid">광운대학교 경영대학 ERP개론 · 1팀</span>
        <span class="sf-right">2026.05.29 발표</span>
      </footer>

    </section>

  </div>
</div>

<!-- 발표자 힌트 (외부) -->
<div class="hint">
  <span class="hint-key">F</span><span class="hint-txt">전체화면</span>
  <span class="hint-sep"></span>
  <span class="hint-key">R</span><span class="hint-txt">애니메이션 재생</span>
</div>

<script src="../shared/script.js"></script>
</body>
</html>
